rules_version = '2';

// OneGrasp Firestore security rules.
// Paste these into: Firebase console → Firestore Database → Rules → Publish.
//
// Model:
//   leads/{uid}    — one document per student (doc id = their auth uid).
//   reports/{id}   — one saved report per assessment.
//   schools/{id}   — admin-managed list of schools.
//
// Only the admin account can read all leads, delete data, and manage schools.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@onegrasp.com';
    }

    // Student leads: a student may create/update only their own row; the admin
    // may read every row, update it (assign school / mark emailed) and delete it.
    match /leads/{uid} {
      allow create, update: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow read, delete:   if isAdmin();
    }

    // Reports: created by the signed-in student; readable by the owner or admin
    // (the admin reads them to generate and email the PDF); deletable by admin.
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read:   if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Schools: fully admin-managed.
    match /schools/{id} {
      allow read, write: if isAdmin();
    }
  }
}
