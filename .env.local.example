
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP — used to email the report from your mailbox (e.g. Hostinger)
# Put the REAL values in .env.local (gitignored), not here.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@onegrasp.com
SMTP_PASS=your-mailbox-password
SMTP_SECURE=true
# Optional overrides:
# REPORT_FROM_EMAIL=OneGrasp <support@onegrasp.com>
# REPORT_BCC_EMAIL=support@onegrasp.com
